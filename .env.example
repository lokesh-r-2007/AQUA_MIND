# AquaMind AI - Environment Configuration Example
# Copy to .env for customized deployments

# Application Settings
APP_NAME=AquaMind AI
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=5173

# Campus Reference Coordinates (Bangalore Campus)
CAMPUS_LATITUDE=12.9716
CAMPUS_LONGITUDE=77.5946
CAMPUS_TIMEZONE=Asia/Kolkata

# Weather Service Configuration
WEATHER_API_TIMEOUT_SECONDS=5.0
WEATHER_CACHE_ENABLED=true

# Database Path
SQLITE_DB_PATH=backend/aquamind.db

# Water Utility Tariff (INR per 1,000 Liters)
WATER_TARIFF_PER_KL=45.0

